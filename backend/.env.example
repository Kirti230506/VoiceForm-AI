# Database Configuration
# Default: Try local MySQL; if not running or credentials differ, automatically uses SQLite fallback
MYSQL_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/voiceform_db
SQLITE_DATABASE_URL=sqlite:///./voiceform.db

# Whisper Configuration
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu

# Server Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
